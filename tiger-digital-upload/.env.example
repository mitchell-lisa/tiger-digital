# Sanity. projectId and dataset are public values and safe to commit here;
# they are set in the Vercel project environment, not in this file.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. Needed later for draft previews and the CSV importer.
# Never commit a real value and never prefix it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

